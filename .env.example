# EchoMind 环境变量
# docker compose 部署时会自动读取此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS
# docker compose 内部地址（容器间通信）
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379/0

# ── MySQL（结构化用户画像/偏好）──────────────────────────────────────────────
PROFILE_BACKEND=mysql
# 填本地独立开发库URL，密码中的特殊字符需URL编码；不要上传真实.env。
# MYSQL_PROFILE_URL=mysql+pymysql://echomind:URL_ENCODED_PASSWORD@127.0.0.1:3306/echomind?charset=utf8mb4
# 旧安装暂不切换画像时显式设 PROFILE_BACKEND=legacy_vector，原画像不会自动迁移。

# ── 向量后端（知识库 + 情景记忆，不再负责新画像）─────────────────────────────
# 未设置VECTOR_BACKEND的旧安装仍使用chroma，迁移验收后显式切换。
# 新安装/切换示例；不要仅复制这一行就认为旧数据已经迁完。
VECTOR_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=echomind_v1
# 本地ONNX目录；不填则复用旧Chroma模型缓存中的onnx目录。
# VECTOR_MODEL_DIR=/home/echomind/.cache/chroma/onnx_models/all-MiniLM-L6-v2/onnx
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 降级用本地路径（ChromaDB 服务不可用时自动切换）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# ── 标准 MCP ─────────────────────────────────────────────────────────────────
# 默认连接无需 Key 的 Microsoft Learn 公开文档 MCP；设 false 可关闭外部连接。
MCP_EXTERNAL_ENABLED=true
# 不填时读取当前项目 config/mcp_servers.json，Docker 内默认路径同样可用。
# MCP_SERVERS_CONFIG=/app/config/mcp_servers.json
# 通过自定义域名访问 /mcp/ 时，将域名加入允许列表（逗号分隔）。
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,echomind,echomind:*,echomind-python,echomind-python:*,your-domain.example
# MCP_ALLOWED_ORIGINS=https://your-domain.example,http://localhost,http://localhost:*

# 本地默认 development；对外部署设置 production 并配置独立随机 API Token（不是模型 Key）。
ECHOMIND_ENV=development
# ECHOMIND_API_TOKENS={"至少24位随机Token":{"user_id":"u1","role":"user"},"另一管理员Token至少24位":{"user_id":"admin","role":"admin"}}

# 三路意图识别：有硅基流动 Key 自动启用当前免费版 BAAI/bge-m3；无 Key 使用本地 n-gram。
# 不使用收费的 Pro/BAAI/bge-m3，不与 ANTHROPIC_API_KEY 共用。
INTENT_EMBEDDING_PROVIDER=auto
SILICONFLOW_API_KEY=
